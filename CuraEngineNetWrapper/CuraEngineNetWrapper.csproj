<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>CuraEngineNetWrapper</Title>
    <Description>CuraEngineNetWrapper</Description>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8603</NoWarn>
    <OutDir>../CuraEngineConnection/build/$(Configuration)</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time reference to CuraConnectionInterface.dll produced by the IDL build step.
         Private=false prevents MSBuild from re-copying it; the package contentFiles entry handles deployment. -->
    <Reference Include="$(OutDir)\CuraConnectionInterface.dll">
      <Private>false</Private>
    </Reference>
    <!-- CAMAPI is provided by the ENCY host process; exclude runtime assets to avoid bundling them. -->
    <PackageReference Include="EncySoftware.CAMAPI.SDK.Net" Version="2.0.24-dev.12" PrivateAssets="all" />
  </ItemGroup>

</Project>
