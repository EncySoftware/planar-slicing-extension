<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>CuraEngineNetWrapper</Title>
    <Description>CuraEngineNetWrapper</Description>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8603</NoWarn>
    <OutDir>../CuraEngineConnection/build/$(Configuration)</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time reference to the IDL-generated COM interop assembly stored in git LFS.
         Private=false prevents MSBuild from copying it to OutDir (it is deployed via the package). -->
    <Reference Include="..\resources\CuraConnectionInterface.dll">
      <Private>false</Private>
    </Reference>
    <!-- CAMAPI is provided by the ENCY host process; exclude runtime assets to avoid bundling them. -->
    <PackageReference Include="EncySoftware.CAMAPI.SDK.Net" Version="2.0.16" PrivateAssets="all" />
  </ItemGroup>

</Project>
