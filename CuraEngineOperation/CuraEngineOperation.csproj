<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>CuraEngineOperation</Title>
    <Description>CuraEngineOperation</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS8603</NoWarn>
    <OutDir>../CuraEngineConnection/build/$(Configuration)</OutDir>
    <Authors>ENCY</Authors>
    <PackageId>EncySoftware.CuraEngineOperation</PackageId>
    <PackageTags>ency-extension;operationsolver</PackageTags>
    <Description>Allows ENCY to calculate toolpath using the CuraEngine which is the part of Ultimaker Cura (https://ultimaker.com/)</Description>
    <PackageIcon>CuraPath_icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/EncySoftware/planar-slicing-extension</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EncySoftware/planar-slicing-extension</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- CAMAPI is provided by the ENCY host process; PrivateAssets=all keeps it out of the .nuspec
       so consumers do not pull ENCY assemblies when restoring this package. -->
  <ItemGroup>
    <PackageReference Include="EncySoftware.CAMAPI.SDK.Net" Version="3.0.7-dev.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile-time references and managed project dependencies. -->
  <ItemGroup>
    <ProjectReference Include="..\CuraEngineNetWrapper\CuraEngineNetWrapper.csproj" />
    <ProjectReference Include="..\CuraEngineParametersLibrary\CuraEngineParametersLibrary.csproj" />
  </ItemGroup>

  <!-- CuraConnectionInterface.dll is produced by the IDL build step (MIDL + tlbimp).
       Placed inside a Target so the build system does not strip it when creating the .copy.csproj for pack.
       Private=false prevents double-copying; the contentFiles entry below handles deployment. -->
  <Target Name="AddCuraConnectionInterfaceRef" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="$(OutDir)\CuraConnectionInterface.dll">
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <!-- Package icon and readme (NuGet metadata only, not deployed to extension folder). -->
  <ItemGroup>
    <None Include="CuraPath_icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Package icon deployed to the ENCY extension folder alongside the main DLL. -->
  <ItemGroup>
    <None Include="CuraPath_icon.png" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Extension descriptor files: deployed alongside the main DLL in the ENCY extension folder. -->
  <ItemGroup>
    <None Include="CuraEngineToolpath_ExtOp.xml" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="CuraEngineOperation.settings.json" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="CuraSettings.json" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Managed dependency DLLs built from source; resolved from the shared OutDir after compilation. -->
  <ItemGroup>
    <None Include="$(OutDir)\CuraEngineNetWrapper.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(OutDir)\CuraEngineParametersLibrary.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(OutDir)\NCalc.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(OutDir)\Antlr4.Runtime.Standard.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- CuraConnectionInterface.dll is built by the IDL step; packed from OutDir. -->
  <ItemGroup>
    <None Include="$(OutDir)\CuraConnectionInterface.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Native DLLs and localisation resources tracked in git LFS under resources/.
       TODO: when rebuilding CuraEngineConnection, update resources/ and commit via LFS. -->
  <ItemGroup>
    <None Include="..\resources\CuraEngineConnection.dll" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\resources\UltimakerCuraPlugin_icon.png" Pack="true" PackagePath="contentFiles/any/any/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\resources\UserLocalization\en-US.po" Pack="true" PackagePath="contentFiles/any/any/UserLocalization/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\resources\UserLocalization\ru_RU.po" Pack="true" PackagePath="contentFiles/any/any/UserLocalization/">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
